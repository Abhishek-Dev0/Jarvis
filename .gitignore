# Python
__pycache__/
*.pyc

# virtual environments
venv/
.venv/
.venv-1/

# model weights & large downloaded artifacts — regenerable/redownloadable,
# don't belong in git history (GitHub blocks >100MB files outright, and
# these total several hundred MB). See README/architecture notes for how to
# re-fetch: Kokoro/Piper via their download URLs, Whisper/Argos/speechbrain
# auto-download on first use.
jarvis/data/models/
jarvis/checkpoints/*.pt
jarvis/checkpoints/chat/
jarvis/data/train.bin
jarvis/data/val.bin
jarvis/data/chat/
jarvis/data/chat.txt
jarvis/data/dolly_pairs.json
jarvis/data/_pre_ftfy_backup/

# sensitive — passphrase hash + voiceprint embedding. Never commit even
# though the passphrase itself isn't recoverable from these files; no reason
# to publish the hash/salt or a biometric embedding either.
jarvis/data/security/

# personal — facts Abi has told JARVIS to remember (modules/memory.py).
# Private by nature, same reasoning as data/security/.
jarvis/data/memory.json

# scraped web cache + runtime logs — local working state, not source
jarvis/data/web/
jarvis/data/logs/

# vector search index (modules/search_index.py) — regenerable from
# data/web/ via "index my documents"
jarvis/data/search_index.json

# self-modify proposals (drafts + sandbox test output) — local working
# state, not source; the applied result (if any) is the real diff to commit
jarvis/data/self_modify/

# editor
.vscode/

# portable gh CLI (downloaded locally to set up the GitHub remote, not part of the project)
.tools/

# local backup of downloaded model weights (jarvis/vendor_models.py) — several
# GB, purely a local durability copy, never belongs in git
/vendor/

# launcher shortcuts — hold absolute, machine-specific paths, regenerate
# per machine rather than commit (Start JARVIS.bat + assets/jarvis_cat.ico
# stay in git; the .lnk files pointing at their absolute path don't)
*.lnk
